{
  "name": "GPT-Live Add-on Development",
  "image": "ghcr.io/home-assistant/devcontainer-addon:latest",
  "features": {},
  "forwardPorts": [
    7123,
    8081,
    18082
  ],
  "portsAttributes": {
    "7123": {
      "label": "Home Assistant"
    },
    "8081": {
      "label": "Voice PE WebSocket"
    },
    "18082": {
      "label": "Speaker audio HTTP"
    }
  },
  "postCreateCommand": "pip3 install -e .",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.linting.flake8Enabled": true
      }
    }
  },
  "remoteUser": "root"
}
